<?xml version="1.0" encoding="utf-8"?>
<!-- Padrão de modal do app: cartão #1A1D24 arredondado, título 20sp, ações à direita. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fundo_arredondado_da_caixa_de_dialogo_do_editor_de_imagem"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/titulo_da_escolha_da_biblioteca"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/titulo_da_escolha_da_biblioteca_para_referencia"
        android:textColor="#F4F7FB"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/subtitulo_da_escolha_da_biblioteca"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#8AB4F8"
        android:textSize="14sp" />

    <!-- Tudo / Imagens / Vídeos (mesmo estilo do filtro do Visualizador de mídia). -->
    <LinearLayout
        android:id="@+id/filtros_da_escolha_da_biblioteca"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:padding="2dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/grade_da_escolha_da_biblioteca"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fadeScrollbars="true"
        android:overScrollMode="never"
        android:paddingBottom="8dp"
        android:scrollbarStyle="outsideOverlay"
        android:scrollbars="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/botao_cancelar_da_escolha_da_biblioteca"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:stateListAnimator="@null"
            android:text="@string/cancelar_caixa_do_editor"
            android:textAllCaps="false"
            android:textColor="#8A9099"
            android:textSize="15sp" />

        <Button
            android:id="@+id/botao_adicionar_da_escolha_da_biblioteca"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/fundo_do_campo_da_caixa_de_dialogo_do_editor_de_imagem"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="#8AB4F8"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
