<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout
        android:id="@+id/painel_da_colecao_flutuante_do_chat"
        android:layout_width="420dp"
        android:layout_height="480dp"
        android:layout_gravity="top|start"
        android:background="@drawable/fundo_da_janela_da_carcaca_da_colecao_flutuante"
        android:clickable="true"
        android:elevation="48dp"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingBottom="12dp">

        <!-- Chrome: título à esquerda, alça centralizada (Samsung), ações à direita. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/fundo_do_cabecalho_da_carcaca_da_colecao_flutuante"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <FrameLayout
                android:id="@+id/alca_para_arrastar_a_colecao_flutuante"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:contentDescription="@string/alca_para_arrastar_a_colecao_flutuante"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="160dp">

                    <TextView
                        android:id="@+id/titulo_da_janela_da_colecao_flutuante"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/colecao_flutuante_do_chat"
                        android:textColor="#E8EAF0"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/subtitulo_da_janela_da_colecao_flutuante"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/subtitulo_padrao_da_janela_da_colecao_flutuante"
                        android:textColor="#5C6274"
                        android:textSize="11sp" />
                </LinearLayout>

                <include
                    layout="@layout/layout_alca_pilula_do_chrome_das_janelas_flutuantes_do_navegador"
                    android:layout_width="56dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/botao_guardar_pagina_da_colecao_na_biblioteca"
                    style="@style/IconeDeAcaoCompactaDoChromeDasJanelasFlutuantes"
                    android:contentDescription="@string/guardar_pagina_da_colecao_na_biblioteca"
                    android:enabled="false"
                    android:src="@drawable/icone_de_guardar_componente_da_carcaca_da_colecao" />

                <ImageButton
                    android:id="@+id/botao_ancorar_colecao_na_gaveta_do_chat"
                    style="@style/IconeDeAcaoCompactaDoChromeDasJanelasFlutuantes"
                    android:layout_marginStart="2dp"
                    android:contentDescription="@string/ancorar_colecao_na_gaveta_do_chat"
                    android:src="@drawable/icone_de_chat_da_openrouter_do_navegador" />

                <ImageButton
                    android:id="@+id/botao_minimizar_colecao_flutuante"
                    style="@style/IconeMinimizarFecharDoChromeDasJanelasFlutuantes"
                    android:contentDescription="@string/minimizar_colecao_flutuante"
                    android:src="@drawable/icone_de_minimizar_janela_do_campo_de_texto_do_navegador" />

                <ImageButton
                    android:id="@+id/botao_fechar_colecao_flutuante"
                    style="@style/IconeMinimizarFecharDoChromeDasJanelasFlutuantes"
                    android:contentDescription="@string/fechar_colecao_flutuante"
                    android:src="@drawable/icone_de_fechar_o_player_de_video" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/faixa_dos_modos_da_colecao_flutuante"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/botao_modo_midia_da_colecao_flutuante"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:padding="8dp"
                android:text="@string/modo_midia_da_colecao_flutuante"
                android:textColor="#8B91A1"
                android:textSize="12.5sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/botao_modo_pagina_da_colecao_flutuante"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:padding="8dp"
                android:text="@string/modo_pagina_da_colecao_flutuante"
                android:textColor="#8B91A1"
                android:textSize="12.5sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/conteudo_midia_da_colecao_flutuante"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <ScrollView
                android:id="@+id/rolagem_da_colecao_flutuante"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/lista_da_colecao_flutuante"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/botao_baixar_marcados_da_colecao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="@string/baixar_marcados_da_colecao"
                        android:textColor="#8AB4F8"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/botao_marcar_todos_da_colecao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="@string/marcar_todos_da_colecao"
                        android:textColor="#C4C7CE"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/botao_excluir_marcados_da_colecao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="@string/excluir_marcados_da_colecao"
                        android:textColor="#F28B82"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/botao_limpar_colecao_flutuante"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="@string/limpar_colecao_flutuante"
                        android:textColor="#C4C7CE"
                        android:textSize="14sp" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/conteudo_pagina_da_colecao_flutuante"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1">

            <android.webkit.WebView
                android:id="@+id/webview_da_pagina_da_colecao_flutuante"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/aviso_pagina_da_colecao_ainda_vazia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:padding="16dp"
                android:text="@string/pagina_da_colecao_ainda_vazia"
                android:textColor="#C4C7CE"
                android:textSize="14sp" />
        </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/alca_de_redimensionar_a_colecao_flutuante"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:clickable="true"
            android:contentDescription="@string/redimensionar_a_colecao_flutuante"
            android:focusable="true">

            <View
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="8dp"
                android:background="@drawable/indicador_de_redimensionar_canto_do_campo_de_texto" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/selo_da_colecao_flutuante_do_chat"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="top|start"
        android:clickable="true"
        android:elevation="52dp"
        android:focusable="true"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="#F5C518"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />
</merge>
