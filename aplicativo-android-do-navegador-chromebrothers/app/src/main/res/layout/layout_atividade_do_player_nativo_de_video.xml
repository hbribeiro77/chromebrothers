<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz_do_player_nativo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/visor_do_player_nativo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_buffering="when_playing"
        app:surface_type="texture_view"
        app:use_controller="true" />

    <LinearLayout
        android:id="@+id/barra_superior_do_player_nativo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/fundo_da_barra_superior_do_player"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/lista_de_velocidades_do_player_nativo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/interruptor_de_captura_de_midia_no_player_nativo"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:contentDescription="@string/capturar_midia_para_download"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/rotulo_curto_da_captura_de_midia"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/botao_baixar_midia_do_player_nativo"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/baixar_midia_da_pagina"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icone_de_baixar_midia_da_pagina"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/botao_salvar_quadro_do_player_nativo"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/salvar_quadro"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icone_de_salvar_quadro_do_player_de_video" />

                <ImageButton
                    android:id="@+id/botao_copiar_quadro_do_player_nativo"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/copiar_quadro"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icone_de_copiar_quadro_do_player_de_video" />

                <ImageButton
                    android:id="@+id/botao_favoritar_o_video_da_biblioteca"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/favoritar_video"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icone_de_video_favorito_contorno" />

                <ImageButton
                    android:id="@+id/botao_abrir_gaveta_da_biblioteca_de_videos"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/abrir_biblioteca_de_videos"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icone_da_gaveta_da_biblioteca_de_videos" />

                <ImageButton
                    android:id="@+id/botao_ver_na_area_da_pagina_do_player_nativo"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/ver_o_video_na_area_da_pagina"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icone_de_ver_o_video_na_area_da_pagina_do_navegador" />

                <ImageButton
                    android:id="@+id/botao_janela_flutuante_do_player_nativo"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/abrir_em_janela_flutuante_o_player_de_video"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icone_de_janela_flutuante_do_player_de_video_sobre_a_navegacao" />

                <ImageButton
                    android:id="@+id/botao_configurar_incremento_do_player_nativo"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/configurar_incremento_do_video"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icone_de_configuracao_do_player_de_video" />

                <ImageButton
                    android:id="@+id/botao_voltar_ao_navegador_do_player_nativo"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/voltar_ao_navegador"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icone_de_fechar_o_player_de_video" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lista_de_incrementos_do_player_nativo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/aviso_do_deslocamento_do_player_nativo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="8"
        android:textColor="#FFFFFF"
        android:textSize="48sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <include
        android:id="@+id/inclusao_da_faixa_de_scrub_fino_do_player_nativo"
        layout="@layout/layout_faixa_de_scrub_fino_por_toque_longo_do_player_de_video"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="72dp" />

    <include
        layout="@layout/layout_gaveta_da_biblioteca_de_videos_do_navegador"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
