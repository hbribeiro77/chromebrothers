<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/fundo_arredondado_da_caixa_de_dialogo_do_editor_de_imagem"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.08"
        android:text="@string/rotulo_componente_nas_opcoes_do_componente_gravado"
        android:textColor="#8A9099"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/titulo_da_caixa_de_opcoes_do_componente_gravado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#F4F7FB"
        android:textSize="20sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/botao_abrir_componente_gravado_nas_opcoes"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/fundo_do_campo_da_caixa_de_dialogo_do_editor_de_imagem"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:stateListAnimator="@null"
        android:text="@string/abrir_componente_gravado_pelo_menu_overflow"
        android:textAllCaps="false"
        android:textColor="#F4F7FB"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/abertura_padrao_do_componente_gravado"
        android:textColor="#C4C7CE"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/fundo_do_campo_da_caixa_de_dialogo_do_editor_de_imagem"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/botao_abertura_padrao_flutuando_do_componente_gravado"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="@string/abertura_padrao_flutuando"
            android:textAllCaps="false"
            android:textSize="15sp" />

        <Button
            android:id="@+id/botao_abertura_padrao_no_chat_do_componente_gravado"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="@string/abertura_padrao_no_chat"
            android:textAllCaps="false"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linha_abrir_junto_com_o_chat_do_componente_gravado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/abrir_junto_com_o_chat_do_componente_gravado"
                android:textColor="#F4F7FB"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/explicacao_abrir_junto_com_o_chat_do_componente_gravado"
                android:textColor="#8A9099"
                android:textSize="13sp" />
        </LinearLayout>

        <Switch
            android:id="@+id/chave_abrir_junto_com_o_chat_do_componente_gravado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:background="#2A3140" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/botao_remover_componente_gravado_nas_opcoes"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="-12dp"
            android:background="@android:color/transparent"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:stateListAnimator="@null"
            android:text="@string/remover_componente_gravado_pelo_menu_overflow"
            android:textAllCaps="false"
            android:textColor="#F28B82"
            android:textSize="15sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/botao_cancelar_opcoes_do_componente_gravado"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="-12dp"
            android:background="@android:color/transparent"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:stateListAnimator="@null"
            android:text="@string/fechar_opcoes_do_componente_gravado"
            android:textAllCaps="false"
            android:textColor="#8A9099"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
