<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/fundo_arredondado_da_caixa_de_dialogo_do_editor_de_imagem"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="20dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/titulo_da_caixa_de_escolha_simples_do_navegador"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:textColor="#F4F7FB"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/lista_de_opcoes_da_caixa_de_escolha_simples_do_navegador"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />

    <Button
        android:id="@+id/botao_cancelar_da_caixa_de_escolha_simples_do_navegador"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:gravity="start|center_vertical"
        android:minHeight="48dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:stateListAnimator="@null"
        android:text="@string/cancelar_caixa_do_editor"
        android:textAllCaps="false"
        android:textColor="#A8B3C4"
        android:textSize="16sp" />
</LinearLayout>
