<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/fundo_arredondado_da_caixa_de_dialogo_do_editor_de_imagem"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/titulo_da_caixa_do_historico_do_chat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/chat_historico_titulo"
        android:textColor="#F4F7FB"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/resumo_do_uso_do_historico_do_chat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#8A9099"
        android:textSize="13sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_marginTop="12dp"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/lista_de_conversas_do_historico_do_chat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/botao_fechar_a_caixa_do_historico_do_chat"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/fundo_do_campo_da_caixa_de_dialogo_do_editor_de_imagem"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:stateListAnimator="@null"
            android:text="@string/chat_historico_fechar"
            android:textAllCaps="false"
            android:textColor="#8AB4F8"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
