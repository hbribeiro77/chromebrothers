<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/fundo_arredondado_da_caixa_de_dialogo_do_editor_de_imagem"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/titulo_da_caixa_de_dialogo_do_editor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#F4F7FB"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/mensagem_da_caixa_de_dialogo_do_editor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#C4C7CE"
        android:textSize="15sp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/campo_da_caixa_de_dialogo_do_editor"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/fundo_do_campo_da_caixa_de_dialogo_do_editor_de_imagem"
        android:hint="@string/titulo_texto_da_composicao"
        android:importantForAutofill="no"
        android:inputType="text"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textColor="#F4F7FB"
        android:textColorHint="#8A9099"
        android:textSize="16sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/botao_cancelar_da_caixa_de_dialogo_do_editor"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="#8A9099"
            android:textSize="15sp" />

        <Button
            android:id="@+id/botao_confirmar_da_caixa_de_dialogo_do_editor"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/fundo_do_campo_da_caixa_de_dialogo_do_editor_de_imagem"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
