<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TemaDoNavegadorChromebrothers" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#1A73E8</item>
        <item name="colorPrimaryVariant">#174EA6</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:statusBarColor">@color/fundo_da_faixa_do_navegador_chromebrothers</item>
        <item name="android:navigationBarColor">@color/fundo_da_pagina_do_navegador_chromebrothers</item>
        <item name="android:windowBackground">@color/fundo_da_pagina_do_navegador_chromebrothers</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="BotaoDaMolduraDaComposicao">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#F4F7FB</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Ações do recorte de trecho no modo de progresso fino do player. -->
    <style name="BotaoDoRecorteDeTrechoDoVideo" parent="BotaoDaMolduraDaComposicao">
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:background">@drawable/fundo_do_campo_da_caixa_de_dialogo_do_editor_de_imagem</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- − / X do chrome das janelas flutuantes (campo, coleção, …). -->
    <style name="IconeMinimizarFecharDoChromeDasJanelasFlutuantes">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <!-- Alias legado do campo de texto. -->
    <style name="IconeDaFaixaDoCampoDeTexto" parent="IconeMinimizarFecharDoChromeDasJanelasFlutuantes" />

    <!-- Guardar / âncora / ações compactas da carcaça. -->
    <style name="IconeDeAcaoCompactaDoChromeDasJanelasFlutuantes">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:background">@drawable/fundo_do_botao_icone_da_carcaca_da_colecao</item>
        <item name="android:padding">7dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="AmostraDaPaletaDoEditorDeImagem">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:padding">4dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:src">@drawable/icone_circular_preenchido_da_cor_do_texto_da_imagem</item>
    </style>
</resources>
